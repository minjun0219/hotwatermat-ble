{
  "name": "hotwatermat-ble",
  "version": "0.1.0",
  "description": "BLE protocol library for heated mattress pad (KDO_HotWaterMat / EQM555) — WASM-powered, no native dependencies",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hotwatermat-ble": "./bin/cli.js"
  },
  "files": [
    "dist/",
    "bin/cli.js",
    "bin/install.js",
    "src/hotwatermat.wasm"
  ],
  "scripts": {
    "build:wasm": "../wasm/build.sh",
    "build": "tsc",
    "postinstall": "node bin/install.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ble",
    "bluetooth",
    "hot-water-mat",
    "iot",
    "wasm",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/minjun0219/hotwatermat-ble"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}